{
  "name": "stream-cipher-laboratory",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild frontend/firebase.js --bundle --format=esm --minify --outfile=static/js/firebase.bundle.js",
    "test": "node --test tests/history.test.mjs tests/password.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-stream-cipher 'node --test tests/firestore.test.mjs'",
    "test:accounts": "firebase emulators:exec --only auth,firestore --project demo-stream-cipher 'node --test tests/auth.test.mjs tests/firestore.test.mjs'"
  },
  "dependencies": {
    "firebase": "13.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "^15.0.0",
    "node": "^24.22.3"
  }
}
